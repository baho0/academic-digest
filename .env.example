# --- Database (SQLite now; any SQLAlchemy URL later, e.g. postgresql+psycopg://...) ---
AD_DATABASE_URL=sqlite:///data/academicdigest.db

# --- Paths to YAML config ---
AD_SOURCES_FILE=config/sources.yaml
AD_SCORING_FILE=config/scoring.yaml

# --- Digest ---
AD_TIMEZONE=Europe/Istanbul
AD_LOOKBACK_HOURS=48

# --- Semantic Scholar enricher (optional) ---
# AD_S2_API_KEY=

# --- SMTP (Gmail now: needs an App Password, https://myaccount.google.com/apppasswords) ---
# Switching to your own mail server later = change only these values.
AD_SMTP_HOST=smtp.gmail.com
AD_SMTP_PORT=587
# starttls | ssl | none
AD_SMTP_SECURITY=starttls
AD_SMTP_USER=you@gmail.com
AD_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
AD_MAIL_FROM=Academic Digest <you@gmail.com>
# Comma-separated list
AD_MAIL_TO=you@gmail.com

# --- Web UI / API (academicdigest serve) ---
AD_WEB_HOST=127.0.0.1
AD_WEB_PORT=8080
# Public URL behind your reverse proxy: adds a "view on the web" link to the email + feed links
# AD_WEB_BASE_URL=https://papers.example.com
# Set both to require HTTP basic auth
# AD_WEB_USER=
# AD_WEB_PASSWORD=

# --- LLM (infrastructure only; no provider ships yet, see src/academicdigest/llm/base.py) ---
AD_LLM_PROVIDER=none
# AD_LLM_MODEL=
# AD_LLM_API_KEY=
# AD_LLM_BASE_URL=
# Hard cap on paid calls per command run (cached answers are free)
AD_LLM_MAX_CALLS=200
