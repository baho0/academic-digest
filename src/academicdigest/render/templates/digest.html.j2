<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{ digest.subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#18181b;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f5;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:680px;background:#ffffff;border-radius:10px;">
  <tr><td style="padding:28px 28px 8px 28px;">
    <div style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#71717a;">Academic Digest</div>
    <div style="font-size:24px;font-weight:700;margin-top:4px;">{{ digest.date }}</div>
    <div style="font-size:13px;color:#71717a;margin-top:4px;">{{ digest.count }} papers selected from {{ digest.candidates }} candidates{% if web_url %} · <a href="{{ web_url }}" style="color:#7c3aed;">view on the web</a>{% endif %}</div>
  </td></tr>
{% if not digest.sections %}
  <tr><td style="padding:16px 28px 28px 28px;font-size:15px;color:#52525b;">Quiet day — no paper cleared the threshold.</td></tr>
{% endif %}
{% for section in digest.sections %}
  <tr><td style="padding:24px 28px 4px 28px;">
    <div style="font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:{{ '#b45309' if section.key == 'top' else '#7c3aed' }};border-bottom:2px solid {{ '#fde68a' if section.key == 'top' else '#ede9fe' }};padding-bottom:6px;">{{ section.title }}</div>
  </td></tr>
  {% for c in section.clusters %}
  <tr><td style="padding:12px 28px;">
    <a href="{{ c.url }}" style="font-size:16px;font-weight:600;color:#18181b;text-decoration:none;line-height:1.35;">{{ c.title }}</a>
    <div style="font-size:12px;color:#52525b;margin-top:4px;">
      {% if section.key == 'top' %}<span style="color:#7c3aed;">{{ categories.get(c.category, c.category) }}</span> · {% endif %}
      {{ c.authors | short_authors or (c.url | domain) }}{% if c.venue %} · <i>{{ c.venue }}</i>{% endif %}
    </div>
    <div style="font-size:12px;color:#71717a;margin-top:3px;">
      {% if c.arxiv_id %}<a href="https://arxiv.org/abs/{{ c.arxiv_id }}" style="color:#71717a;">arXiv:{{ c.arxiv_id }}</a>{% elif c.doi %}<a href="https://doi.org/{{ c.doi }}" style="color:#71717a;">doi:{{ c.doi }}</a>{% else %}{{ c.url | domain }}{% endif %}
      {% if c.pdf_url %} · <a href="{{ c.pdf_url }}" style="color:#71717a;">PDF</a>{% endif %}
      {% if c.code_url %} · <a href="{{ c.code_url }}" style="color:#71717a;">Code</a>{% endif %}
      {% for name, link in c.discussions %} · <a href="{{ link }}" style="color:#71717a;">{{ name }}{% if c.metric('hf_upvotes') and 'huggingface' in link %} ({{ c.metric('hf_upvotes') | int }} ▲){% elif c.metric('hn_points') and 'ycombinator' in link %} ({{ c.metric('hn_points') | int }} pts){% endif %}</a>{% endfor %}
    </div>
    {% if c.summary %}<div style="font-size:14px;color:#3f3f46;margin-top:6px;line-height:1.5;">{{ c.summary }}</div>{% endif %}
    {% if explain %}<div style="font-family:ui-monospace,Menlo,monospace;font-size:11px;color:#a1a1aa;margin-top:6px;">score {{ '%.1f' | format(c.score) }} = {% for b in c.breakdown %}{{ b }}{% if not loop.last %}, {% endif %}{% endfor %} · [{{ c.source_names | join(', ') }}]{% if c.notes.llm_reason %} · llm: {{ c.notes.llm_reason }}{% endif %}</div>{% endif %}
  </td></tr>
  {% endfor %}
{% endfor %}
  <tr><td style="padding:24px 28px 28px 28px;font-size:11px;color:#a1a1aa;border-top:1px solid #f4f4f5;">
    Ranked by venue, community attention (Hugging Face, Hacker News), cross-source coverage and your interests.
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
