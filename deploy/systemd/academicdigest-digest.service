[Unit]
Description=Academic Digest - build and email the daily digest
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=academicdigest
Group=academicdigest
WorkingDirectory=/opt/academic-digest
# Collects once more, then sends. Safe to re-run: a day already sent is skipped.
ExecStart=/opt/academic-digest/.venv/bin/academicdigest digest
TimeoutStartSec=30min

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/academic-digest/data
